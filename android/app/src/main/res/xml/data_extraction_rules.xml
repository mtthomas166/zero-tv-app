<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup / device-transfer policy. Veil keeps watch history,
  bookmarks, progress and prefs in local Hive boxes. None of it should leave
  the device via cloud backup or device-to-device transfer, so everything is
  excluded. Pairs with android:allowBackup="false" for older Android.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
